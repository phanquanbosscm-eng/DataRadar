{
  "name": "feiping-radar",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --input-type=module --eval \"import {createServer} from './node_modules/vite/dist/node/index.js';const s=await createServer({root:process.cwd()});await s.listen();s.printUrls();\"",
    "build": "node --input-type=module --eval \"import {build} from './node_modules/vite/dist/node/index.js';await build({root:process.cwd()});\"",
    "preview": "node --input-type=module --eval \"import {preview} from './node_modules/vite/dist/node/index.js';const s=await preview({root:process.cwd()});s.printUrls();\""
  },
  "dependencies": {
    "chokidar": "^3.6.0",
    "cors": "^2.8.6",
    "express": "^4.22.1",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.1",
    "jspdf-autotable": "^3.8.2",
    "papaparse": "^5.4.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^2.12.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "rollup": "3.29.4",
    "tailwindcss": "^3.4.3",
    "vite": "4.5.3"
  }
}
